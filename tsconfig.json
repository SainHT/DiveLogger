{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@scuba-log/shared/*": [
        "./shared/*"
      ],
      "@scuba-log/shared": [
        "./shared/index.ts"
      ]
    }
  },
}
